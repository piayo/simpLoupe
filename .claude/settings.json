{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm ci)",
      "Bash(npm ls:*)",
      "Bash(npm outdated:*)",
      "Bash(node ./syncVersion.js)",
      "Bash(node ./scripts/:*)",
      "Bash(npx oxlint:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(unzip -l:*)"
    ]
  }
}
