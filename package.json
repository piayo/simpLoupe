{
  "name": "simpLoupe",
  "version": "2.0.2",
  "description": "シンプルなルーペ(拡大鏡)の Chrome 拡張機能",
  "author": "piayo",
  "license": "MIT",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.10",
      "onFail": "warn"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "dev": "run-s clean copy:* dev:vite",
    "dev:vite": "vite build --watch --mode development",
    "build": "run-s clean build:version copy:* build:js",
    "build:test": "node ./scripts/with-key.mjs build",
    "build:version": "node ./syncVersion.js",
    "build:js": "tsc && vite build",
    "copy": "run-s copy:*",
    "copy:locales": "cpy \"**/*.json\" ../../dist/_locales --cwd=src/_locales",
    "copy:img": "cpy \"src/img/*\" dist/img --flat",
    "copy:manifest": "cpy src/manifest.json dist --flat",
    "verify": "run-s lint fmt:check typecheck test i18n:check",
    "check": "node ./scripts/check-dist.mjs",
    "check:test": "node ./scripts/check-dist.mjs --test",
    "zip": "run-s verify build check zip:pack",
    "zip:pack": "npm-build-zip --source=dist --destination=./zip --name=$npm_package_version --name_only=true",
    "zip:test": "run-s build:test check:test zip:test:pack",
    "zip:test:pack": "npm-build-zip --source=dist --destination=./zip --name=$npm_package_version-test --name_only=true",
    "i18n:build": "node ./scripts/i18n/build-store.mjs",
    "i18n:verify": "node ./scripts/i18n/build-store.mjs --check",
    "i18n:check": "run-s i18n:check:*",
    "i18n:check:ui": "node ./scripts/i18n/check-ui.mjs",
    "i18n:check:store": "node ./scripts/i18n/check-store.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui --coverage",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "cpy-cli": "^7.0.0",
    "happy-dom": "^20.11.1",
    "npm-build-zip": "^2.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "0.62.0",
    "oxlint": "^1.77.0",
    "rimraf": "^6.0.1",
    "rollup-plugin-minify-template-literals": "^2.1.0",
    "terser": "^5.49.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@webcomponents/custom-elements": "^1.6.0",
    "lit": "^3.2.1"
  }
}
